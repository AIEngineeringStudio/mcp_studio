MCP_LAB_ENVIRONMENT=local
MCP_LAB_LOG_LEVEL=INFO
MCP_LAB_LOG_FORMAT=console
MCP_LAB_SERVER_TRANSPORT=stdio
MCP_LAB_SERVER_HOST=127.0.0.1
MCP_LAB_SERVER_PORT=8000
MCP_LAB_TRACING_ENABLED=true
MCP_LAB_TRACE_EXPORTER=console
